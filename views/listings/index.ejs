<% layout("/layouts/boilerplate")%>
<body>
    <h2>All Listings</h2>
    
    <div class="row row-cols-lg-3 row-cols-md-2 row-cols-sm-1" >
        <% for(let list of allListing){ %>
        <div class="listing-card card" style="width: 18rem;">
            <img src="<%=list.image.url%>" class="card-img-top" alt="Listing's Image" style="height: 20rem;">
            <div class=" card-body ">
                <h5 class="card-title"><%=list.title%></h5>
                <p class="card-text"><%= list.description%> </p>
                <div class="d-flex justify-content-between align-items-center mt-auto">
                   <a href="/listings/<%=list._id%>" class="btn btn-primary">View</a>
                    <p class="mb-0">Price:  &#8377; <%= list.price.toLocaleString("en-IN") %></p>
                </div>
            </div>  
        </div>
    <%  } %>
    
    </div>

    
</body>