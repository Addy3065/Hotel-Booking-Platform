<%layout("/layouts/boilerplate") %>
<% const hasMap = list.geometry && list.geometry.coordinates && list.geometry.coordinates.length === 2; %>
<% const reviewCount = list.reviews.length; %>
<% const avgRating = reviewCount ? list.reviews.reduce((sum, r) => sum + (r.rating || 0), 0) / reviewCount : 0; %>
<body>
  <div class="row mt-4">
    <div class="col-8 offset-2">
      <h3><%= list.title %></h3>
      <i>Owned by <%= list.owner ? list.owner.username : "Unknown" %></i>
      <p class="star-display mb-0 mt-1">
        <% if (reviewCount) { %>
        <% for (let i = 1; i <= 5; i++) { %>
        <% const filled = Math.round(avgRating * 2) / 2; %>
        <i class="<%= i <= filled ? 'fa-solid fa-star' : i - 0.5 === filled ? 'fa-solid fa-star-half-stroke' : 'fa-regular fa-star' %>"></i>
        <% } %>
        <span class="ms-1"><%= avgRating.toFixed(1) %>/5</span>
        <span class="text-muted">(<%= reviewCount %> review<%= reviewCount > 1 ? "s" : "" %>)</span>
        <% } else { %>
        <i class="fa-regular fa-star"></i> <span class="text-muted">No ratings yet</span>
        <% } %>
      </p>
      <div class="card col-12 listing-card mt-3">
        <img
          src="<%= list.image.url %>"
          class="card-img-top show-img"
          alt="listing-image"
        />
        <div class="card-body">
          <!-- <p class="card-text"></p> -->
        </div>
      </div>
      <ul class="list-group">
        <!-- <li class="list-group-item"><h4><%= list.title %></h4></li> -->
        <li class="list-group-item"><%= list.description %></li>
        <li class="list-group-item">
          &#8377; <%= list.price.toLocaleString("en-IN") %>
        </li>
        <li class="list-group-item"><%= list.location %></li>
        <li class="list-group-item"><%= list.country %></li>
      </ul>

      <br />

      <% if(currentUser && list.owner && currentUser._id.equals(list.owner._id)){%>
      <div class="d-flex gap-2 mb-4">
        <form method="get" action="/listings/<%= list._id %>/edit">
          <button class="btn btn-primary">Edit</button>
        </form>
        <form method="post" action="/listings/<%= list._id %>?_method=DELETE">
          <button class="btn btn-danger">Delete</button>
        </form>
      </div>
<%}%>




      <!-- REVIEWS -->

      <div>
        <% if(currentUser){ %>
        <h4>Leave a review</h4>
        <form
          action="/listings/<%= list._id %>/reviews"
          method="post"
          class="mb-3 needs-validation"
          novalidate
        >
          <div class="mb-3 mt-3">
            <label class="form-label d-block">Rating</label>
            <!-- star rating input: radios are laid out in reverse so CSS can highlight every star up to the hovered/checked one -->
            <fieldset class="star-rating">
              <% for (let i = 5; i >= 1; i--) { %>
              <input
                type="radio"
                id="rate<%= i %>"
                name="review[rating]"
                value="<%= i %>"
                required
              />
              <label for="rate<%= i %>" title="<%= i %> star<%= i > 1 ? 's' : '' %>"
                ><i class="fa-solid fa-star"></i
              ></label>
              <% } %>
            </fieldset>
            <div class="invalid-feedback star-feedback">Please select a rating!</div>
          </div>
          <div class="mb-3 mt-3">
            <label for="comment" class="form-label">Comments</label>
            <textarea
              name="review[comment]"
              id="comment"
              cols="30"
              rows="5"
              class="form-control"
              required
            ></textarea>
            <div class="invalid-feedback">Add a comment!</div>
          </div>

          <button class="btn btn-outline-dark">Post</button>
        </form>
        <hr />
        <% } %>

        <div class="row">
          <h4>
            All Reviews
            <% if (reviewCount) { %>
            <span class="avg-rating ms-2">
              <i class="fa-solid fa-star"></i> <%= avgRating.toFixed(1) %>/5
              <small class="text-muted">(<%= reviewCount %> review<%= reviewCount > 1 ? "s" : "" %>)</small>
            </span>
            <% } %>
          </h4>
          <% if (!reviewCount) { %>
          <p class="text-muted">No reviews yet.</p>
          <% } %>
          <% if (!currentUser) { %>
          <p><a href="/login">Log in</a> to leave a review.</p>
          <% } %>
          <% for(let review of list.reviews){ %>
          <div class="card review-card col-5 mb-3 ms-3">
            <div class="card-body">
              <h5 class="card-title">@<%= review.author ? review.author.username : "Unknown user" %></h5>
              <p class="star-display mb-1" title="Rated <%= review.rating %> out of 5">
                <% for (let i = 1; i <= 5; i++) { %>
                <i class="fa-<%= i <= review.rating ? 'solid' : 'regular' %> fa-star"></i>
                <% } %>
                <span class="ms-1 text-muted">(<%= review.rating %>/5)</span>
              </p>
              <p class="card-text"><%= review.comment %></p>
            </div>
            <% if(currentUser && review.author && currentUser._id.equals(review.author._id)){ %>
            <form method="post" action="/listings/<%= list._id %>/reviews/<%= review._id %>?_method=DELETE">
              <button class="btn btn-sm btn-dark mt-3 mb-2">Delete</button>
            </form>
            <% } %>
          </div>
          <% } %>
        </div>
      </div>
    </div>
  </div>

    <div class="row mt-4 mb-4">
      <div class="col-8 offset-2">
        <h3>Where You will be</h3>
        <% if (hasMap) { %>
        <div
          id="map"
          data-map-token="<%= process.env.MAP_TOKEN || '' %>"
          data-coordinates="<%= JSON.stringify(list.geometry.coordinates) %>"
        ></div>
        <% } else { %>
        <p class="text-muted">Map unavailable: couldn't find "<%= list.location %>, <%= list.country %>" on the map.</p>
        <% } %>
      </div>
    </div>

</body>
<% if (hasMap) { %>
<% if (!process.env.MAP_TOKEN) { %>
<!-- Mapbox GL needs a token, so without one the map is drawn with Leaflet + OpenStreetMap tiles -->
<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
<% } %>
<script src="/js/map.js"></script>
<% } %>
